{
  "name": "bimoto",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:server": "pnpm --filter @bimoto/server dev",
    "dev:client": "pnpm --filter @bimoto/client dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:server": "pnpm --filter @bimoto/server test",
    "test:client": "pnpm --filter @bimoto/client test",
    "test:e2e": "pnpm --filter @bimoto/e2e test",
    "wiring:map": "tsx scripts/wiring-audit/cli.ts",
    "wiring:check": "tsx scripts/wiring-audit/check.ts",
    "wiring:test": "tsx --test scripts/wiring-audit/tests/extract.test.ts scripts/wiring-audit/tests/check.test.ts",
    "constants:map": "tsx scripts/constants-guard/cli.ts",
    "constants:check": "tsx scripts/constants-guard/check.ts",
    "constants:test": "tsx --test scripts/constants-guard/tests/check.test.ts scripts/constants-guard/tests/literals.test.ts",
    "constants:literals": "tsx scripts/constants-guard/census.ts",
    "routes:map": "tsx scripts/route-guard/cli.ts",
    "routes:check": "tsx scripts/route-guard/check.ts",
    "routes:test": "tsx --test scripts/route-guard/tests/check.test.ts scripts/route-guard/tests/rule2.test.ts scripts/route-guard/tests/rule3.test.ts",
    "routes:census3": "tsx scripts/route-guard/census3.ts",
    "routes:census": "tsx scripts/route-guard/census.ts",
    "serialize:map": "tsx scripts/serialization-guard/cli.ts",
    "serialize:check": "tsx scripts/serialization-guard/check.ts",
    "serialize:test": "tsx --test scripts/serialization-guard/tests/check.test.ts",
    "txn:map": "tsx scripts/txn-guard/cli.ts",
    "txn:check": "tsx scripts/txn-guard/check.ts",
    "txn:test": "tsx --test scripts/txn-guard/tests/check.test.ts",
    "pins:check": "tsx scripts/pin-guard/check.ts",
    "deps:check": "tsx scripts/dep-guard/check.ts",
    "deps:test": "tsx --test scripts/dep-guard/tests/check.test.ts",
    "projects:check": "tsx scripts/project-guard/check.ts",
    "projects:test": "tsx --test scripts/project-guard/tests/check.test.ts",
    "pins:test": "tsx --test scripts/pin-guard/tests/check.test.ts",
    "typecheck": "pnpm --filter @bimoto/server exec tsc --noEmit && pnpm --filter @bimoto/server exec tsc --noEmit -p tsconfig.tools.json && pnpm --filter @bimoto/client exec tsc --noEmit && pnpm --filter @bimoto/client exec tsc --noEmit -p tsconfig.root.json && pnpm --filter @bimoto/shared exec tsc --noEmit && pnpm --filter @bimoto/shared exec tsc --noEmit -p tsconfig.test.json && pnpm --filter @bimoto/e2e exec tsc --noEmit && pnpm exec tsc --noEmit -p scripts/constants-guard && pnpm exec tsc --noEmit -p scripts/i18n-review && pnpm exec tsc --noEmit -p scripts/wiring-audit && pnpm exec tsc --noEmit -p scripts/route-guard && pnpm exec tsc --noEmit -p scripts/serialization-guard && pnpm exec tsc --noEmit -p scripts/txn-guard && pnpm exec tsc --noEmit -p scripts/pin-guard && pnpm exec tsc --noEmit -p scripts/dep-guard && pnpm exec tsc --noEmit -p scripts/project-guard",
    "landmarks:verify": "node scripts/verify-landmarks.mjs",
    "landmarks:geocode": "node scripts/verify-landmarks.mjs --geocode",
    "landmarks:evidence": "node scripts/verify-landmarks.mjs --from-evidence scripts/landmark-geocode-evidence-raw.json",
    "landmarks:build": "node scripts/build-landmarks.mjs",
    "landmarks:test": "node --test scripts/tests/verify-landmarks.test.mjs",
    "map:build": "sh scripts/build-region-pmtiles.command",
    "map:polys": "sh scripts/derive-province-polys.command",
    "map:test": "node --test scripts/tests/geojson-to-poly.test.mjs scripts/tests/select-admin4.test.mjs && sh scripts/tests/test-build-region.sh",
    "i18n:review": "tsx scripts/i18n-review/cli.ts",
    "i18n:review:baseline": "tsx scripts/i18n-review/cli.ts --accept-baseline",
    "i18n:review:check": "tsx scripts/i18n-review/check.ts",
    "i18n:review:test": "tsx --test scripts/i18n-review/tests/generate.test.ts scripts/i18n-review/tests/check.test.ts",
    "db:migrate:dev": "pnpm --filter @bimoto/server db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @bimoto/server db:migrate:deploy",
    "db:seed": "pnpm --filter @bimoto/server db:seed"
  },
  "engines": {
    "node": ">=22.9.0 <23"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "axios": "^1.19.0",
      "form-data@2": "^2.5.6",
      "form-data@4": "^4.0.6",
      "engine.io": "^6.6.9",
      "socket.io-parser": "^4.2.7",
      "ws": "^8.21.3",
      "websocket-driver": "^0.7.5",
      "@grpc/grpc-js": "^1.14.4",
      "protobufjs": "^7.6.5",
      "node-forge": "^1.4.0",
      "path-to-regexp": "~0.1.13",
      "lodash": "^4.18.1",
      "js-yaml@4": "^4.3.1",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": "^5.0.9",
      "qs": "^6.15.2",
      "body-parser": "^1.20.6",
      "joi@17": "^17.13.4",
      "joi@18": "^18.2.1"
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
