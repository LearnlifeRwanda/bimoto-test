# ---------------------------------------------------------------------------
# Client (Vite) configuration.
#
# EVERY VALUE HERE IS BAKED IN AT BUILD TIME. Vite inlines import.meta.env
# into the bundle, so these are not runtime settings: changing one means
# rebuilding the APK or the web bundle, not flipping a switch on a running
# server. A wrong value ships to every phone that installs that build and
# cannot be corrected without another release — which is why this file has
# to list all of them, not just the ones someone remembered.
# ---------------------------------------------------------------------------

# Base URL of the Bimoto API server.
VITE_API_URL="http://localhost:3000"

# Flutterwave PUBLIC key for the in-browser card-payment widget
# (R3-PAYMENT-CARD-CLIENT). This is the *public* key — safe to ship to
# the client. The secret key stays server-side only. When unset, the
# card option fails fast with a "use Mobile Money" message and the MoMo
# flow is unaffected.
VITE_FLW_PUBLIC_KEY=""

# Arms native push notifications (PUSH-CRASH G1). Leave unset/false
# unless the native build ships real Firebase config
# (android/app/google-services.json): in a Firebase-less APK, the
# native register() call crashes the app, so builds must never arm
# push without it.
VITE_PUSH_ENABLED="false"

# Emergency press-and-hold duration, in milliseconds (QUEUE-UNITY G4).
# How long the red button must be held before the confirm dialog opens.
# Default 1000. Raised from 700 because the hold is now one of three
# gates (hold → confirm → 3 s cancel window) rather than the only one,
# so it can afford more margin for pockets, knees, rain and gloves.
# BUILD-TIME: Vite inlines this, so changing it means rebuilding the
# APK, not flipping a switch on a running app. Unset, unparseable or
# non-positive values fall back to the default.
VITE_SOS_HOLD_MS="1000"

# Emergency cancel window, in milliseconds (QUEUE-UNITY G4). How long
# the sheet counts down before notifying Bimoto, during which the user
# can stop it. Default 3000. tel:112 is one tap away throughout and is
# never gated by this. Same build-time caveat as above.
VITE_SOS_CANCEL_MS="3000"

# GROUNDSKEEPER G5 — read by the client and documented nowhere until now.

# Ride-trace recording cadence, in milliseconds (RIDE-TRACE G2). One GPS
# point per interval while a leg is under way, written to the local buffer
# and drained by SyncManager. Default 8000. Unset, unparseable or
# non-positive values fall back to the default. Tunable from the field
# without rebuilding the decision — but, being build-time, not without
# rebuilding the app.
VITE_RIDE_TRACE_MS="8000"

# Emergency follow cadence, in milliseconds (SOS-FOLLOW G4). How often a
# phone streaming an active alert emits its position to the admins room.
# Default 5000.
VITE_EMERGENCY_FOLLOW_MS="5000"

# Local cap on an emergency follow, in milliseconds (SOS-FOLLOW G4).
# Mirrors the server's 60-minute valve on the phone's own clock, because
# the phone most likely to still be streaming an hour in is exactly the one
# that lost the socket carrying the message that would have stopped it.
# Default 3600000.
VITE_EMERGENCY_FOLLOW_CAP_MS="3600000"

# Set only by the e2e harness to expose test-only affordances. Must never
# be set on a build that reaches a real phone.
# VITE_E2E_TESTING="true"
