# Capacitor build artefacts — generated per-build, not source.
# Project structure (build.gradle, Info.plist, etc.) IS committed
# under packages/client/{ios,android}/; only the items below are excluded.

# iOS
ios/App/Pods/
ios/App/build/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/DerivedData/
ios/.build/
ios/App/Podfile.lock
ios/.symlinks/

# Android
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/release/
android/app/debug/
android/captures/
android/.idea/
android/*.iml
android/app/*.iml
android/app/google-services.json
android/keystore.properties
android/*.jks
android/*.keystore

# Generated web assets that Capacitor copies in (regenerated by `cap sync`)
ios/App/App/public/
android/app/src/main/assets/public/
