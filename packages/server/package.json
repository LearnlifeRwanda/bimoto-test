{
  "name": "@bimoto/server",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.9.0 <23"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=.env src/index.ts",
    "build": "tsc && node scripts/copy-runtime-assets.js",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/index.js",
    "start:dev": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env src/index.ts",
    "pretest": "pnpm --filter @bimoto/shared build",
    "test": "jest --forceExit --detectOpenHandles",
    "test:sms-e2e": "jest --forceExit --testMatch \"**/__tests__/**/sender-match.e2e.ts\"",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "documents:encrypt": "tsx scripts/encrypt-existing-documents.ts",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@bimoto/shared": "workspace:*",
    "@prisma/client": "^5.20.0",
    "@sentry/node": "^8.0.0",
    "africastalking": "^0.8.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-stringify": "^6.9.0",
    "@parse/node-apn": "^6.4.0",
    "express": "^4.22.3",
    "firebase-admin": "^13.10.0",
    "flutterwave-node-v3": "^1.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "jest": "^29.7.0",
    "pmtiles": "3.2.1",
    "prisma": "^5.20.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  }
}
