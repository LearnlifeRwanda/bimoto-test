// Cascade discipline (Dispatch Q): every @relation MUST have an explicit
// onDelete directive. Default is Restrict (parent deletion rejected if
// children exist). Use Cascade only for tightly-coupled derived rows.
// Use SetNull only for soft references (e.g., Bid.autoBidRuleId where a
// historical bid survives rule deletion).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  DRIVER
  BOTH
  ADMIN
  COOPERATIVE_LEADER

  // INTEL-DECK G4 — read-only mobility intelligence. An ANALYST can open
  // the k-anonymised aggregate surface at /intel and nothing else: every
  // other guard in middleware/auth.ts refuses any role it does not name,
  // so this value is locked out of the operational product by
  // construction rather than by a denylist somebody has to maintain.
  ANALYST
}

enum Language {
  rw
  en
  fr
}

enum VehicleType {
  BIKE
  MOTO
  E_MOTO
  E_BIKE
}

enum JourneyType {
  PASSENGER
  GOODS
  // R3-PRIORITY — intermediate-urgency parcel. 1.15x fare premium +
  // half-speed cascade expansion. Faster broadcast to the wider radius
  // than NORMAL but no SLA-window stamping (URGENT_MESSENGER stamps
  // targetCompletionAt = now + 30min on acceptBid; PRIORITY does not).
  PRIORITY_MESSENGER
  // R3-T — time-sensitive parcel. Cascade bypass + 1.3x urgency
  // premium + 30-min target completion window stamped at acceptBid.
  URGENT_MESSENGER
}

// R3-LEGS — multi-stop trip foundation. Adds intermediate stops to a
// journey between pickup (Journey.pickup*) and destination (Journey.destination*).
// Single-leg journeys ship with legs: [] (the v1 default).
// Multi-leg journeys are introduced by R3-DELIVERY (sub-case B, customer+parcel)
// and R3-POOL (sub-case C, driver-bundled deliveries).
enum LegType {
  PASSENGER_PICKUP
  PASSENGER_DROPOFF
  GOODS_PICKUP
  GOODS_DROPOFF
  WAIT
}

enum LegStatus {
  PENDING
  ACTIVE
  COMPLETED
  SKIPPED
}

// R3-DELIVERY — parcel size for goods-drop / goods-pickup legs.
// Drives the 4th compositional fare axis via parcelMultiplier in
// fair-price.service.ts. Non-goods legs (PASSENGER_PICKUP/DROPOFF/WAIT)
// MUST have parcelSize: null (enforced by validateLegSequence post-R3-DELIVERY).
enum ParcelSize {
  SMALL // <= 5kg, fits in driver's bag — courier envelope, small box
  MEDIUM // 5-15kg, fits in motorcycle box — typical retail package
  LARGE // 15-30kg, requires cargo bicycle or larger — bulk goods
}

// R3-DELIVERY-V2 — parcel content category surfaced to the driver as a
// handling-expectation badge. Optional even on goods legs (UI defaults
// to OTHER on submit). Forbidden on non-goods legs (enforced by
// validateLegSequence's PARCEL_CATEGORY_ON_NON_GOODS_LEG block code).
enum ParcelCategory {
  FOOD
  ELECTRONICS
  DOCUMENTS
  FRAGILE
  OTHER
}

// R3-RECIPIENT-CONFIRM-2 — how the GOODS_DROPOFF leg reached the
// "recipient acknowledged" state. NULL when recipientConfirmedAt is
// NULL. Legacy R3-RECIPIENT-CONFIRM rows have recipientConfirmedAt set
// + recipientConfirmStatus NULL — the customer-side UI treats this as
// "EXPLICIT_REPLY (legacy)" for display purposes (no backfill — the
// data-layer additive-only invariant forbids it).
enum RecipientConfirmStatus {
  EXPLICIT_REPLY
  AUTO_TIMEOUT
  DISPUTED
}

enum JourneyStatus {
  SCHEDULED
  REQUESTED
  MATCHED
  IN_PROGRESS
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
  INTERRUPTED
  DISPUTED
  EXPIRED
}

enum BookingMode {
  IMMEDIATE
  SCHEDULED
}

enum JourneyRequestMode {
  WAIT_AND_COMPARE
  NEED_TO_GO
}

enum ReconciliationResponse {
  ARRIVED_SAFELY
  NEVER_ARRIVED
  NEED_HELP
}

enum BidStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

// Who moved a bid to WITHDRAWN: a human (driver via app/SMS) or server
// machinery. Nullable on Bid — pre-migration rows stay null and keep
// counting in the bid-cycle detector.
enum BidWithdrawnSource {
  USER
  SYSTEM
}

// COUNTER-READY G1 — how a bid's one counter-offer ended.
//
// Null (no member) is the fourth and commonest state: no counter was
// ever made. ACCEPTED means the driver took the countered price and the
// bid went on through the ordinary accept path at that price; DECLINED
// means he said no and the bid stays PENDING at its ORIGINAL price, so
// the customer can still accept what he first offered; LAPSED is written
// by bid expiry when a counter was never answered.
enum CounterOutcome {
  ACCEPTED
  DECLINED
  LAPSED
}

enum EscrowStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  FROZEN
  FAILED
}

enum DriverPayoutStatus {
  PENDING
  SUCCESS
  FAILED
}

// DRIVER-ID v3 — REVOKED is the terminal identity state: the driver's
// number is no longer valid and the public lookup answers "not active".
// It is distinct from freeze (money investigation, User.frozenAt) and
// suspension (behaviour, User.suspendedUntil) and changes neither. The
// only way out is re-application: the driver-verification submission
// flow resets REVOKED -> PENDING; no code path may set REVOKED ->
// VERIFIED directly.
enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  REVOKED
}

enum PayoutPreference {
  AT_SHIFT_END
  TWICE_DAILY
  DAILY_22H
}

enum PayoutBatchTrigger {
  SCHEDULED_22H
  SCHEDULED_06
  SCHEDULED_18
  SHIFT_END
  PREFERENCE_CHANGE
  FALLBACK_24H
  ADMIN
}

enum AmlFlagType {
  HARD_LIMIT_EXCEEDED
  SOFT_LIMIT_EXCEEDED
  DAILY_CUMULATIVE_EXCEEDED
  VELOCITY_EXCEEDED
  PAIR_FREQUENCY
  NEW_ACCOUNT_HIGH_VALUE
  BURST_SILENCE
  FAILURE_CLUSTERING
  PAYOUT_CONCENTRATION
  COLLUSION_RING
  MONEY_FUNNEL
  REPUTATION_RING
  GEO_ANOMALY
  SYNC_RATING_ATTACK
  BID_CYCLE_RING
}

enum AmlFlagSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AmlFlagStatus {
  OPEN
  DISMISSED
  MARKED_FOR_FREEZE
  RESOLVED
}

enum BidAmountMode {
  FLAT
  PERCENT_OF_FAIR_PRICE
}

enum PushPlatform {
  IOS
  ANDROID
}

// R3-N-1 — cancellation taxonomy. BOTH_NO_SHOW is system-derived only
// (R3-N-2 auto-timeout job will emit it) and is rejected if a user
// supplies it via the cancel route.
enum CancelReason {
  CUSTOMER_CHANGED_MIND
  DRIVER_NO_SHOW
  DRIVER_LATE
  DRIVER_WRONG_VEHICLE
  SAFETY_CONCERN
  CUSTOMER_NO_SHOW
  DRIVER_CAN_NOT_MAKE_IT
  BOTH_NO_SHOW
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  /// AES-256-GCM ciphertext (iv:ct:tag hex) — NEVER dialable, NEVER
  /// displayable. Read it only through services/user-phone.ts.
  phoneEncrypted    String   @unique @map("phone")
  phoneHash         String   @unique
  nickname          String
  role              UserRole
  language          Language @default(rw)
  idVerified        Boolean  @default(false)
  licenseVerified   Boolean  @default(false)
  /// AES-256-GCM ciphertext of JSON.stringify(string[]); legacy rows may
  /// hold plain JSON. Read it only through services/user-phone.ts.
  emergencyContactsEncrypted String? @map("emergencyContacts")
  completedRides    Int      @default(0)
  cancellationCount Int      @default(0)
  totalRequests     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  driverProfile      DriverProfile?
  journeysAsCustomer Journey[]       @relation("CustomerJourneys")
  journeysAsDriver   Journey[]       @relation("DriverJourneys")
  bids               Bid[]
  sentMessages       Message[]
  ratingsGiven       Rating[]        @relation("RatingsGiven")
  ratingsReceived    Rating[]        @relation("RatingsReceived")
  // TEAM-ANSWERS G3 — reports this driver FILED. There is deliberately
  // no `rideReportsReceived` back-relation: a report is about a ride,
  // and giving a person a collection of reports is the first step
  // toward the per-passenger number this design refuses to create.
  rideReportsFiled   RideReport[]    @relation("RideReportsFiled")
  syncEvents         SyncEvent[]
  syncRejections     SyncRejection[]
  emergencyAlertsRaised    EmergencyAlert[] @relation("EmergencyAlertsRaised")
  emergencyAlertsResolved  EmergencyAlert[] @relation("EmergencyAlertsResolved")
  escrowsAsCustomer  Escrow[]        @relation("CustomerEscrows")
  escrowsAsDriver    Escrow[]        @relation("DriverEscrows")

  privacyConsentAt      DateTime?
  privacyConsentVersion String?
  termsAcceptedAt       DateTime?
  termsAcceptedVersion  String?
  driverTermsAcceptedAt DateTime?
  driverTermsVersion    String?
  accountDeletedAt      DateTime?
  isDeleted             Boolean   @default(false)
  disputeCount          Int       @default(0)
  disputeRate           Float     @default(0)
  isFlagged             Boolean   @default(false)
  flagReason            String?

  payoutPreference PayoutPreference @default(AT_SHIFT_END)
  completedShifts  Int              @default(0)

  // MONEY-PIN G1 — the four-digit number that stands between a borrowed
  // phone and a motari's money surfaces. Founder ruling D25.
  //
  // STORAGE FOLLOWS OtpCode EXACTLY (PREPROTO-AUTH G1): only hmacOtp(pin)
  // is ever at rest, comparisons are constant-time, and wrong guesses are
  // counted rather than merely rate-limited. The plaintext PIN exists in
  // the user's head and in one TLS request body, nowhere else — never in
  // a log, never on the device, never in a column.
  moneyPinHash String?

  // The RESET pair. A reset proven only by SMS OTP does not take effect
  // for 24 hours (moneyPinPendingActivatesAt), and an SMS says so at the
  // moment it is requested. That window is the whole defence against the
  // borrowed-phone hole: whoever holds the handset also holds the SMS,
  // so proving possession of the phone must NOT be enough to reach the
  // money today. The owner, who knows the live PIN, can cancel inside it.
  //
  // No job activates these. A pending hash past its activatesAt becomes
  // live on the NEXT VERIFY — the state machine is read at the only
  // moment it can matter.
  moneyPinPendingHash        String?
  moneyPinPendingActivatesAt DateTime?

  // Brute-force budget, mirroring OtpCode.attemptCount. Reset to 0 on
  // every successful verify; a lockout is a timestamp rather than a
  // boolean so it expires without anything having to run.
  moneyPinAttempts    Int       @default(0)
  moneyPinLockedUntil DateTime?

  scheduledCancellationCount Int @default(0)

  customerInitiatedCompletionCount Int @default(0)
  lateCompletionCount              Int @default(0)

  // R3-N-1 — asymmetric cancel attribution. Float on noShowCount and
  // lateMarkCount because BOTH_NO_SHOW (R3-N-2 system-derived) and
  // DRIVER_LATE apply +0.5 to each side.
  noShowCount                      Float @default(0)
  driverInitiatedCancellationCount Int   @default(0)
  wrongVehicleCount                Int   @default(0)
  lateMarkCount                    Float @default(0)

  // R3-N-4 — graduated penalty for driver no-shows. Set to a future
  // timestamp by applyDriverPenaltyForNoShow when a no-show count
  // crosses the SUSPENSION_24H_THRESHOLD; bid.service.createBid checks
  // suspendedUntil > now() and rejects bids with DRIVER_SUSPENDED.
  suspendedUntil DateTime?

  payoutPreferenceChangeLogs PayoutPreferenceChangeLog[]
  driverConflictOverrides    DriverConflictOverride[]
  reconciliationResponses    JourneyReconciliationResponse[]
  amlFlags                   AmlFlag[]

  smsOptOut   Boolean      @default(false)
  smsInbounds SmsInbound[]

  frozenAt       DateTime?
  frozenReason   String?
  frozenBy       String?         @db.Uuid
  frozenCategory FreezeCategory?
  adminActions   AdminAction[]   @relation("AdminActions")

  autoBidRules DriverAutoBidRule[] @relation("DriverAutoBidRules")

  cooperativeId          String?
  cooperative            Cooperative? @relation("UsersInCooperative", fields: [cooperativeId], references: [id], onDelete: SetNull)
  cooperativeLed         Cooperative? @relation("CooperativeLed")
  bidsDispatchedByLeader Bid[]        @relation("BidsDispatchedByLeader")

  deviceTokens DeviceToken[]

  vehicleChangeLogs VehicleChangeLog[]

  feeWaivers FeeWaiver[] @relation("DriverFeeWaivers")

  pickupVerifications PickupVerification[] @relation("CustomerPickupVerifications")

  errorReports ErrorReport[]

  // ACCOUNT-RIGHTS-CORE G1 — the deletion requests this user has made.
  // A list, not a single row: cancelling and asking again creates a new
  // one, and the partial unique index keeps at most one of them PENDING.
  deletionRequests DeletionRequest[]

  @@index([phoneHash])
  @@index([smsOptOut])
  @@index([frozenAt])
  @@index([cooperativeId])
}

model DriverProfile {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String      @unique @db.Uuid
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType        VehicleType
  registrationPlate  String?
  vehicleDescription String
  avgRating          Decimal     @default(0) @db.Decimal(3, 2)
  totalRides         Int         @default(0)
  isOnline           Boolean     @default(false)
  lastLat            Float?
  lastLng            Float?
  lastLocationAt     DateTime?

  drivingLicenseNumber      String?
  // DRIVER-ID v3 — the person-first identifier ("jacket number").
  // Unique so the public validity lookup resolves to exactly one
  // driver; Postgres unique indexes permit multiple NULLs, so legacy
  // rows without a number are unaffected. Mandatory (with the plate)
  // before a profile may be set VERIFIED — enforced in
  // driver-verification.service, not the schema, because pre-approval
  // rows legitimately have no number yet.
  ruraAuthorizationNumber   String?            @unique
  cooperativeName           String?
  insuranceConfirmed        Boolean            @default(false)
  verificationStatus        VerificationStatus @default(PENDING)
  drivingLicensePhotoUrl    String?
  ruraAuthorizationPhotoUrl String?
  insurancePhotoUrl         String?
  verifiedAt                DateTime?
  rejectionReason           String?
  // DRIVER-ID v3 — mirrors verificationStatus REVOKED (set on revoke,
  // cleared when a re-application moves the profile back to PENDING).
  // The permanent record of the revocation is the hash-chained
  // AdminAction row, not this column.
  revokedAt                 DateTime?

  active Boolean @default(true)

  cooperativeId String?
  cooperative   Cooperative? @relation("DriversInCooperative", fields: [cooperativeId], references: [id], onDelete: Restrict)

  // R3-DRIVER-SCREENER — 1:1 self-attested screener (eligibility +
  // matching hints). Optional because legacy drivers (onboarded before
  // R3-DRIVER-SCREENER landed) have no row yet.
  screener DriverScreener?

  @@index([isOnline])
  @@index([cooperativeId])
}

// DRIVER-ID v3 — append-only ledger of driver vehicle changes (the
// person is the identity; the motorcycle is a mutable, honestly-tracked
// attribute). One row per self-service change of type/plate/description,
// old -> new. The account-deletion anonymization write deliberately does
// NOT log here: it is an erasure, not a switch. Deliberately shaped for
// later fraud-pattern use (rapid serial changes), but no detector
// consumes it in this dispatch.
model VehicleChangeLog {
  id        String   @id @default(uuid()) @db.Uuid
  driverId  String   @db.Uuid
  driver    User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  changedAt DateTime @default(now())

  oldVehicleType VehicleType
  newVehicleType VehicleType
  oldPlate       String?
  newPlate       String?
  oldDescription String
  newDescription String

  @@index([driverId, changedAt])
}

// R3-DRIVER-SCREENER — 8-question driver eligibility screener. 1:1 with
// DriverProfile via @unique on driverProfileId. The catalogue (questions,
// answer kinds, eligibility logic) lives in packages/shared/src/screener/
// and is the single source of truth.
model DriverScreener {
  id              String @id @default(cuid())
  driverProfileId String @unique @db.Uuid

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  // Catalogue answers — mirror packages/shared/src/screener/questions.ts
  is18OrOlder             Boolean
  holdsDriversLicence     ScreenerLicenceStatus
  hasRuraAuthorisation    ScreenerRuraStatus
  primaryVehicleType      VehicleType
  cooperativeId           String?
  cooperative             Cooperative? @relation("CooperativeScreenerAffiliation", fields: [cooperativeId], references: [id], onDelete: SetNull)
  cooperativeNameProvided String?
  // primaryCityBand is stored as the shared TS literal union value
  // ('kigali_dense' | 'kigali_periphery' | 'bugesera_corridor' | 'other').
  // Validated at the Zod boundary in screener.schema.ts.
  primaryCityBand         String
  weeklyAvailabilityHours Int
  priorPlatformExperience Boolean
  priorPlatformMonths     Int?

  // Outcome — pure-function output from evaluateEligibility(answers).
  eligibilityResult   ScreenerEligibilityResult
  ineligibilityReason ScreenerIneligibilityReason?

  completedAt DateTime @default(now())

  @@index([eligibilityResult])
  @@index([primaryCityBand])
  @@index([completedAt])
}

enum ScreenerLicenceStatus {
  YES
  IN_PROGRESS
  NO
}

enum ScreenerRuraStatus {
  HAVE
  APPLYING
  NOT_YET
}

enum ScreenerEligibilityResult {
  ELIGIBLE
  INELIGIBLE
  NEEDS_FOLLOW_UP
}

enum ScreenerIneligibilityReason {
  UNDER_18
  NO_DRIVERS_LICENCE
  NEEDS_RURA_PATH
  LOW_AVAILABILITY
}

model Journey {
  id                String        @id @default(uuid()) @db.Uuid
  customerId        String        @db.Uuid
  customer          User          @relation("CustomerJourneys", fields: [customerId], references: [id], onDelete: Restrict)
  driverId          String?       @db.Uuid
  driver            User?         @relation("DriverJourneys", fields: [driverId], references: [id], onDelete: Restrict)
  type              JourneyType   @default(PASSENGER)
  status            JourneyStatus @default(REQUESTED)
  pickupLat         Float
  pickupLng         Float
  pickupName        String
  destinationLat    Float
  destinationLng    Float
  destinationName   String

  // OUTBOX G2 — the client's name for the booking ATTEMPT that produced
  // this journey, used to make POST /api/journeys idempotent for the
  // offline outbox's replay.
  //
  // The dangerous failure is not the request that never arrived; it is
  // the one that arrived, wrote this row, and whose 201 died on the way
  // back to a phone in a dead zone. The phone cannot tell the two apart,
  // so the replay re-sends — and without this column that is a second
  // ride booked for a passenger who wanted one.
  //
  // Nullable with no default: every journey booked before this existed
  // has none, and a client that does not send one is unaffected. The
  // unique index is scoped to the customer, so two passengers can never
  // collide with each other, and NULLs do not collide at all in
  // Postgres — an unstamped create is never blocked by another.
  clientRequestId   String?  @db.Uuid

  // LANDMARKS G4 — the passenger's own words about each place, for the
  // places no database knows. Optional everywhere; NULL on every journey
  // created before this migration.
  pickupDescription      String?  @db.VarChar(200)
  destinationDescription String?  @db.VarChar(200)

  // TEAM-SAID G1 — "Travelling with a child?", a flag and not a flow.
  // The team voted the child-passenger declaration off for the pilot
  // (6 of 7, item 9) and asked instead for one honest signal whose only
  // job is to tell the motari before he arrives. It is deliberately NOT
  // hasChildPassenger: it drives no fare multiplier, no acknowledgment
  // modal and no 422 in the child taxonomy. Nullable with no default,
  // so every journey booked before it existed simply has no answer,
  // which is distinct from having answered "no".
  travellingWithChild Boolean?
  vehiclePreference VehicleType?
  wishPrice         Int?
  agreedPrice       Int?
  commissionAmount  Int?
  estimatedDistance Float?
  startedAt         DateTime?
  endedAt           DateTime?
  confirmedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // R3-N-1 — set in the same tx as the REQUESTED→MATCHED transition;
  // R3-N-1 cancel-flow validates elapsed-since-matched against this.
  matchedAt    DateTime?
  cancelledAt  DateTime?
  cancelReason CancelReason?

  // R3-T — for URGENT_MESSENGER journeys, stamped at acceptBid as
  // matchedAt + 30 min. Informational at this dispatch (UI surfaces
  // it; existing R3-N-1 DRIVER_LATE flow handles missed-window
  // cancellation).
  targetCompletionAt DateTime?

  // R3-CHILD — child-passenger declaration. Set at createJourney
  // when the customer toggles "I am travelling with a child". Drives
  // the 1.1x CHILD_PASSENGER_MULTIPLIER fare premium and surfaces
  // the <ChildPassengerBadge> + <ChildAcknowledgmentModal> on the
  // driver side. Validator at services/child-safety/booking-validator
  // gates createJourney on (vehicleType, childAgeYears) under
  // placeholder legal thresholds (TODO: legal-research).
  hasChildPassenger             Boolean @default(false)
  childAgeYears                 Int?
  childIsUnaccompaniedMinor     Boolean @default(false)
  childGuardianPhone            String?
  childPassengerHelmetConfirmed Boolean @default(false)

  // R3-N-4 — driver disputes a system-attributed DRIVER_NO_SHOW. Set
  // by POST /api/journeys/:id/dispute-no-show; surfaces an admin
  // conflict via the DRIVER_NO_SHOW_DISPUTE ConflictType.
  driverDisputedAt DateTime?

  // R3-N-4 — customer re-discovery lineage. Set on the NEW journey
  // created by POST /api/journeys/:id/redispatch; redispatchedFromId
  // points back at the cancelled DRIVER_NO_SHOW journey.
  redispatchedFromId String?   @db.Uuid
  redispatchedFrom   Journey?  @relation("Redispatch", fields: [redispatchedFromId], references: [id], onDelete: SetNull)
  redispatches       Journey[] @relation("Redispatch")

  goodsDescription  String?
  goodsSizeCategory String?
  // PARCEL-CATEGORY — what the parcel CONTAINS, asked of the sender on
  // the send-a-package form exactly as the drop-a-package leg flow has
  // asked it since R3-DELIVERY-V2. Same ParcelCategory enum, same five
  // choices, same locale keys; a motari reads it before he accepts.
  //
  // Nullable for the same reason the Leg column is: every parcel row in
  // the database predates the question, and NULL means "was never
  // asked", which is not the same answer as OTHER. The customer-facing
  // form defaults to OTHER on submit (the leg-flow convention), so rows
  // created after this dispatch are non-NULL in practice.
  //
  // Distinct from goodsFragile, which stays exactly what it was: a
  // handling boolean feeding the tier/handling logic. A fragile
  // electronics parcel is legitimately ELECTRONICS + goodsFragile:true.
  parcelCategory    ParcelCategory?
  // FIELD-FIT G5 — declared parcel weight in kg. Nullable: the field is
  // optional on create, and every journey booked before it existed has
  // no value. Checked against the vehicle rules in
  // shared/constants/parcel-weight.ts at create time.
  goodsWeightKg     Float?
  // TEAM-SAID G3 — delivery speed, exactly two tiers (Jean, item 13):
  // STANDARD or EXPRESS. This is a tier TAG and not a price: express
  // carries no surcharge and no percentage, because a parcel sender
  // and a motari agree the fare through the same suggest/bid mechanic
  // as every other journey. Stored as a String rather than a Prisma
  // enum to stay additive — a new enum type would need every existing
  // row migrated into it, and the whole point is that NULL (booked
  // before tiers existed) remains a valid, meaningful state.
  deliverySpeed     String?
  /// LIVE-WIRE G5 — Jean's item 13(c): a STANDARD parcel may carry an
  /// OPTIONAL delivery window of 1, 2 or 3 hours. Express means now and
  /// never carries one. Like deliverySpeed this is a tag the motari
  /// reads, never a price input: nothing multiplies a fare by it, and
  /// NULL (no window asked for, or a body predating the field) stays a
  /// meaningful state distinct from any number.
  standardDeliveryHours Int?
  goodsFragile      Boolean @default(false)
  recipientName     String?
  recipientPhone    String?
  pickupPhotoUrl    String?
  deliveryPhotoUrl  String?

  bookingMode          BookingMode @default(IMMEDIATE)
  scheduledFor         DateTime?
  bidWindowOpensAt     DateTime?
  autoFallbackAt       DateTime?
  lastReminderSentAt   DateTime?
  // R3-N-2 — set by no-show-timeout cron when the 20-min push reminder
  // for a MATCHED+startedAt:null journey has fired. Separate from
  // lastReminderSentAt (used by auto-confirm.job for the 12-h
  // AWAITING_CONFIRMATION SMS) because a journey can pass through both
  // states and reusing one field would cross-contaminate idempotency.
  noShowReminderSentAt DateTime?

  discoveryStartedAt DateTime? @default(now())

  // Dispatch K3 — customer modes + suggest-up.
  // requestMode is per-journey (not a sticky preference). When
  // NEED_TO_GO, priceCeilingMultiplier (1.0..2.0) and the locked
  // priceCeilingRwf (round(fairPrice * multiplier)) drive auto-accept.
  // suggestUpCount tracks how many times the customer raised the
  // wish-price via the +50/+100 progressive buttons.
  requestMode            JourneyRequestMode @default(WAIT_AND_COMPARE)
  priceCeilingMultiplier Float?
  priceCeilingRwf        Int?
  suggestUpCount         Int                @default(0)

  lateCompletion              Boolean?  @default(false)
  customerInitiatedCompletion Boolean?  @default(false)
  staleDetectedAt             DateTime?
  reconciliationOpenedAt      DateTime?
  dueAt                       DateTime?

  bids                    Bid[]
  messages                Message[]
  ratings                 Rating[]
  rideReports             RideReport[]
  escrow                  Escrow?
  syncEvents              SyncEvent[]
  gpsPoints               GpsPoint[]
  emergencyAlerts         EmergencyAlert[]
  reconciliationResponses JourneyReconciliationResponse[]
  amlFlags                AmlFlag[]

  // R3-LEGS — multi-stop foundation. Single-leg journeys ship with legs: []
  // (the v1 default and the entirety of pilot v1 traffic to date). Multi-leg
  // journeys are populated by R3-DELIVERY's customer + parcel multi-stop flow.
  // Legs execute in `sequence` order between Journey.pickup* and Journey.destination*.
  legs Leg[] @relation("JourneyLegs")

  // PILOT-INSTRUMENT — at most one pickup-identity answer per journey.
  pickupVerification PickupVerification?

  @@index([status])
  @@index([customerId])
  @@index([driverId])
  @@index([createdAt])
  @@index([status, bidWindowOpensAt])
  @@index([status, autoFallbackAt])
  @@index([status, dueAt])
  @@index([discoveryStartedAt])
  @@index([requestMode])
  @@index([redispatchedFromId])
  @@index([driverDisputedAt])
  // OUTBOX G2 — one journey per (customer, booking attempt). This is the
  // whole no-double-booking guarantee: the pre-check in createJourney is
  // the fast path, and this index is what makes the race safe when two
  // replays of the same held booking arrive at once.
  @@unique([customerId, clientRequestId])
}

// PILOT-INSTRUMENT — pickup-identity verification signal (the V-4
// evidence trigger). One optional row per journey: the customer's
// answer to "Is this your driver? (jacket #NNNN)" shown when the
// server-derived approachStatus hits 'arrived' on the matched screen.
// Evidence only, never enforcement: nothing may freeze, flag, cancel,
// or notify off this table — it exists so the pilot can measure the
// pickup-mismatch rate and decide whether the per-ride dynamic QR/PIN
// second factor (V-4) is worth building. Read by humans via
// GET /api/admin/pickup-verifications/summary.
enum PickupOutcome {
  MATCHED
  MISMATCH
  UNSURE
}

model PickupVerification {
  id         String        @id @default(uuid()) @db.Uuid
  journeyId  String        @unique @db.Uuid
  journey    Journey       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  customerId String        @db.Uuid
  customer   User          @relation("CustomerPickupVerifications", fields: [customerId], references: [id], onDelete: Cascade)
  outcome    PickupOutcome
  // One-tap vocabulary only (WRONG_NUMBER / NO_VEST / DIFFERENT_PERSON,
  // enforced by the shared zod schema) — never free text, so the ledger
  // stays countable and collects no incidental PII.
  reason     String?
  createdAt  DateTime      @default(now())
  // The prompt upserts (last answer wins); updatedAt records the final
  // answer's time.
  updatedAt  DateTime      @updatedAt

  @@index([outcome, createdAt])
  @@index([createdAt])
}

// R3-LEGS — multi-stop trip foundation. Each row represents an
// intermediate stop on a journey, sitting between Journey.pickup*
// (the origin) and Journey.destination* (the final dropoff). The
// driver visits legs in increasing `sequence` order. Single-leg
// journeys (the entirety of pilot v1 traffic to date) have no rows
// in this table — `journey.legs` returns []. Cascade-on-delete: a
// journey's legs have no meaning without their parent journey.
model Leg {
  id                      String                  @id @default(uuid()) @db.Uuid
  journeyId               String                  @db.Uuid
  journey                 Journey                 @relation("JourneyLegs", fields: [journeyId], references: [id], onDelete: Cascade)
  // The position in the journey's leg ordering. 0-indexed. Legs
  // execute in increasing `sequence` order; gaps are not permitted.
  sequence                Int
  type                    LegType
  status                  LegStatus               @default(PENDING)
  // Location (lat/lng/name follow the same conventions as
  // Journey.pickup* / destination*).
  lat                     Float
  lng                     Float
  name                    String
  // Optional contact info — the recipient (or sender) at this stop.
  // Used by R3-DELIVERY to surface "ring this number on arrival" hints
  // to the driver.
  contactName             String?
  contactPhone            String?
  // Optional expected duration in minutes. Drives ETA recomputation
  // when R3-DELIVERY ships its UI surface.
  expectedDurationMinutes Int?
  // Set when the driver taps "I have completed this stop" via
  // POST /api/journeys/:id/legs/:legId/complete. Status transitions
  // to COMPLETED at the same time.
  completedAt             DateTime?
  // R3-DELIVERY — parcel size for goods stops. NULL for non-goods legs
  // (PASSENGER_PICKUP/DROPOFF/WAIT). The journey's largest parcelSize
  // across its legs determines the parcelMultiplier in fair-price.
  parcelSize              ParcelSize?
  // R3-DELIVERY-V2 — parcel content category for goods stops. NULL for
  // non-goods legs and for legacy rows created before this dispatch.
  // The customer-facing UI defaults to OTHER on submit, so new goods
  // legs created post-R3-DELIVERY-V2 are non-NULL in practice.
  parcelCategory          ParcelCategory?
  // R3-RECIPIENT-CONFIRM — set when a parcel recipient SMS-replies to the
  // delivered notification with a confirmation keyword (RECEIVED, OK,
  // MURAKOZE, …). NULL for non-goods legs and for unconfirmed deliveries.
  recipientConfirmedAt    DateTime?
  // R3-DELIVERY-NOTIFICATIONS-2 — optional per-recipient language hint
  // entered by the customer in GoodsStopEditor. When NULL, recipient SMS
  // falls back to the journey customer's User.language. Set per-leg so a
  // multi-recipient journey can address each recipient in their own tongue.
  recipientLanguage       Language?
  // R3-RECIPIENT-CONFIRM-2 — how the leg reached recipient-acknowledged
  // state. Set in lock-step with recipientConfirmedAt by the
  // recipient-confirm handler (EXPLICIT_REPLY), the auto-confirm-recipient
  // cron (AUTO_TIMEOUT), or the recipient-dispute handler (DISPUTED).
  // NULL on legacy rows (pre-R3-RECIPIENT-CONFIRM-2 confirmations) — the
  // UI treats null + non-null recipientConfirmedAt as a legacy explicit
  // confirmation.
  recipientConfirmStatus  RecipientConfirmStatus?
  // R3-RECIPIENT-CONFIRM-2 — verbatim SMS body when a recipient flags the
  // parcel as wrong/damaged. NULL unless recipientConfirmStatus = DISPUTED.
  recipientDisputeReason  String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([journeyId, sequence])
  @@index([journeyId, sequence])
}

model JourneyReconciliationResponse {
  id               String                 @id @default(uuid()) @db.Uuid
  journeyId        String                 @db.Uuid
  journey          Journey                @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  respondingUserId String                 @db.Uuid
  respondingUser   User                   @relation(fields: [respondingUserId], references: [id], onDelete: Restrict)
  response         ReconciliationResponse
  gpsLat           Float?
  gpsLng           Float?
  createdAt        DateTime               @default(now())

  @@unique([journeyId, respondingUserId])
  @@index([journeyId])
}

model DriverConflictOverride {
  id                String   @id @default(uuid()) @db.Uuid
  driverId          String   @db.Uuid
  driver            User     @relation(fields: [driverId], references: [id], onDelete: Restrict)
  scheduledRideId   String   @db.Uuid
  conflictingRideId String   @db.Uuid
  overriddenAt      DateTime @default(now())
  resolved          Boolean  @default(false)
  resolutionNotes   String?

  @@index([driverId, overriddenAt])
  @@index([scheduledRideId])
}

model Bid {
  id         String    @id @default(uuid()) @db.Uuid
  journeyId  String    @db.Uuid
  journey    Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  driverId   String    @db.Uuid
  driver     User      @relation(fields: [driverId], references: [id], onDelete: Restrict)
  price      Int
  etaMinutes Int
  status     BidStatus @default(PENDING)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Set when status becomes WITHDRAWN; null on legacy rows, never defaulted.
  withdrawnSource BidWithdrawnSource?

  // COUNTER-READY G1 — the customer's ONE counter-offer on this bid.
  //
  // The columns ARE the singularity rule. One counter per bid, ever, is
  // enforced by there being exactly one slot to write into: a second
  // counter has nowhere to go, so the endpoint's 409 and the schema
  // agree by construction. A separate table would have needed a unique
  // index to say the same thing, and would have put the counter outside
  // the row the AML graph detectors already scan.
  //
  // Same never-defaulted-on-legacy convention as withdrawnSource above:
  // all three are null on every row that never carried a counter, and
  // `counterOutcome == null && counterAmountRwf != null` is precisely
  // "countered, still unanswered" — the state bid expiry lapses.
  counterAmountRwf Int?
  counterAt        DateTime?
  counterOutcome   CounterOutcome?

  autoBidRuleId String?            @db.Uuid
  autoBidRule   DriverAutoBidRule? @relation("AutoBidsFromRule", fields: [autoBidRuleId], references: [id], onDelete: SetNull)

  dispatchedByLeaderId String? @db.Uuid
  dispatchedByLeader   User?   @relation("BidsDispatchedByLeader", fields: [dispatchedByLeaderId], references: [id], onDelete: SetNull)

  @@unique([journeyId, driverId])
  @@index([journeyId])
  @@index([driverId])
  @@index([autoBidRuleId])
  @@index([dispatchedByLeaderId])
}

model DriverAutoBidRule {
  id                 String        @id @default(uuid()) @db.Uuid
  driverId           String        @db.Uuid
  priority           Int
  enabled            Boolean       @default(true)
  maxPickupDistanceM Int
  maxRideDistanceM   Int
  vehicleTypeFilter  String?
  bidAmountMode      BidAmountMode @default(FLAT)
  bidAmountValue     Float
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  driver User  @relation("DriverAutoBidRules", fields: [driverId], references: [id], onDelete: Cascade)
  bids   Bid[] @relation("AutoBidsFromRule")

  @@unique([driverId, priority])
  @@index([driverId, enabled])
  @@index([enabled])
}

model Escrow {
  id           String       @id @default(uuid()) @db.Uuid
  journeyId    String       @unique @db.Uuid
  journey      Journey      @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  customerId   String       @db.Uuid
  customer     User         @relation("CustomerEscrows", fields: [customerId], references: [id], onDelete: Restrict)
  driverId     String       @db.Uuid
  driver       User         @relation("DriverEscrows", fields: [driverId], references: [id], onDelete: Restrict)
  amount       Int
  commission   Int
  driverPayout Int
  status       EscrowStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  releasedAt   DateTime?

  driverTier             String?
  customerTier           String?
  driverCommissionRate   Float?
  customerCommissionRate Float?

  txRef               String?   @unique
  flwTxId             String?
  lastChargeAttemptAt DateTime?

  // LAUNCH-TRUTH G1 — compute-then-zero record. When a fee waiver is
  // active at settlement, `commission` holds the CHARGED amount (0) and
  // `waivedCommissionAmount` holds what the nominal tier rate would have
  // charged, so receipts and the BNR aggregators keep telling the truth.
  // Both null/absent on unwaived rides. onDelete: Restrict — a waiver
  // that zeroed real money can never be deleted out from under its
  // escrow rows (the audit must outlive the incentive).
  waivedCommissionAmount Int?
  feeWaiverId            String?    @db.Uuid
  feeWaiver              FeeWaiver? @relation(fields: [feeWaiverId], references: [id], onDelete: Restrict)

  auditLog         EscrowAuditLog[]
  nameMismatchLogs NameMismatchLog[]
  amlFlags         AmlFlag[]

  @@index([status])
  @@index([status, createdAt])
  @@index([feeWaiverId])
}

// LAUNCH-TRUTH G1 — one audited grant per waived driver. A waiver is an
// incentive, and incentives get farmed: every ride it zeroes points back
// here via Escrow.feeWaiverId, so a future detector has the data even
// though none is built in this dispatch. Keyed on User.id — the money
// path (Escrow.driverId, DriverBalance.driverId) keys on the user, not
// the DriverProfile. At most one non-revoked waiver per driver: enforced
// by a partial unique index (raw SQL in the migration; Prisma cannot
// express partial indexes) AND re-checked in the grant service.
model FeeWaiver {
  id             String        @id @default(uuid()) @db.Uuid
  driverId       String        @db.Uuid
  driver         User          @relation("DriverFeeWaivers", fields: [driverId], references: [id], onDelete: Restrict)
  type           FeeWaiverType
  campaign       String
  grantedAt      DateTime      @default(now())
  grantedBy      String        @db.Uuid
  // Null for LIFETIME — it never expires.
  expiresAt      DateTime?
  extensionCount Int           @default(0)
  revokedAt      DateTime?
  revokedBy      String?       @db.Uuid
  reason         String

  escrows Escrow[]

  @@index([driverId, revokedAt])
  @@index([type, revokedAt])
}

model DriverBalance {
  id            String   @id @default(uuid()) @db.Uuid
  driverId      String   @unique @db.Uuid
  pendingAmount Int      @default(0)
  lastUpdatedAt DateTime @default(now()) @updatedAt
}

model DriverPayoutBatch {
  id            String             @id @default(uuid()) @db.Uuid
  driverId      String             @db.Uuid
  amount        Int
  txRef         String?            @unique
  flwTransferId String?
  status        DriverPayoutStatus @default(PENDING)
  trigger       PayoutBatchTrigger @default(SCHEDULED_22H)
  failureReason String?
  createdAt     DateTime           @default(now())
  paidOutAt     DateTime?
  // Set by markBatchTransferReversed when a settled transfer bounces at the
  // gateway (SUCCESS -> FAILED). Null for reversals from before 2026-07 —
  // consumers fall back to paidOutAt for those.
  reversedAt    DateTime?

  held       Boolean   @default(false)
  heldAt     DateTime?
  heldBy     String?   @db.Uuid
  heldReason String?

  // PAYOUT-IDEMPOTENCY invariant: at most one un-settled (PENDING) batch
  // per driver, enforced by a PARTIAL unique index that PSL cannot express
  // (@@unique has no WHERE clause). It lives in raw SQL in migration
  // 20260729000000_payout_idempotency_one_inflight_batch:
  //   CREATE UNIQUE INDEX "DriverPayoutBatch_driverId_pending_key"
  //     ON "DriverPayoutBatch"("driverId") WHERE "status" = 'PENDING'
  // Prisma's introspection ignores partial indexes, so the e2e
  // faithfulness gate (`migrate diff --from-url ... --exit-code`) does not
  // see it and never proposes dropping it. Do not add a plain
  // @@unique([driverId]) here — that would forbid a driver's payout
  // history entirely, not just concurrent in-flight batches.
  @@index([driverId, status])
  @@index([createdAt])
  @@index([held])
}

/// How a sensitive change was proven. OTP is the SMS step-up this flow
/// used before MONEY-PIN G2; PIN is the money PIN that replaced it.
enum StepUpMethod {
  OTP
  PIN
}

model PayoutPreferenceChangeLog {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  oldPreference PayoutPreference
  newPreference PayoutPreference
  ipAddress     String?
  /// TRUE only for rows whose step-up was an SMS OTP. Kept, rather than
  /// folded into stepUpMethod, so every row written before MONEY-PIN G2
  /// stays interpretable exactly as it was — a historical audit row must
  /// not change meaning because a later dispatch added a second method.
  otpVerified   Boolean          @default(false)
  /// MONEY-PIN G2 — which proof actually gated this change. The PIN
  /// REPLACED the OTP on this flow (ruling D25), so the audit row has to
  /// say which one was given; recording every row as "otpVerified" once
  /// PIN rows exist would make the column a lie.
  stepUpMethod  StepUpMethod     @default(OTP)
  payoutFired   Boolean          @default(false)
  payoutDueAt   DateTime?
  createdAt     DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([payoutFired, payoutDueAt])
}

model NameMismatchLog {
  id                  String   @id @default(uuid()) @db.Uuid
  escrowId            String   @db.Uuid
  escrow              Escrow   @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  customerId          String   @db.Uuid
  walletNameOnReceipt String
  accountName         String
  txRef               String
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([customerId])
}

model EscrowAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  escrowId       String   @db.Uuid
  escrow         Escrow   @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  sequenceNumber Int
  action         String
  previousHash   String
  entryHash      String   @unique
  amount         Int
  triggeredBy    String
  metadata       Json?
  createdAt      DateTime @default(now())

  // BID-ATOMICITY G3 — the hash chain cannot fork: at most one entry per
  // (escrowId, sequenceNumber), enforced by the database. Two appends
  // racing on one escrow both compute last+1; the loser's insert fails
  // P2002 and appendAuditEntryTx re-reads, recomputes and retries
  // (bounded) so legitimate concurrent appends serialize instead of
  // forking the chain. The migration
  // 20260731000000_bid_atomicity_audit_chain_unique pre-flights
  // pre-existing duplicates: benign double-appends (same action, amount,
  // previousHash) are resequenced past the chain tail with a metadata
  // marker (reversible, nothing deleted); divergent-payload duplicates
  // ABORT the migration for human review — this is the money audit
  // trail, and no migration may pick a survivor between forked hashes.
  @@unique([escrowId, sequenceNumber])
}

model GpsPoint {
  id        String   @id @default(uuid()) @db.Uuid
  journeyId String   @db.Uuid
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  accuracy  Float?
  timestamp DateTime
  syncedAt  DateTime @default(now())

  @@index([journeyId, timestamp])
  // Serves the nightly retention sweep's "timestamp < cutoff" deletes
  // (jobs/gps-retention.job.ts) — the composite index above cannot.
  @@index([timestamp])
}

// Expiry-based single-runner lease for long calendar jobs (withJobLease in
// services/job-lock.ts). One row per job name while a run is in flight; a
// crashed holder's stale row is claimable once expiresAt passes.
model JobLease {
  name       String   @id
  holder     String
  acquiredAt DateTime
  expiresAt  DateTime
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  journeyId      String   @db.Uuid
  journey        Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  senderId       String   @db.Uuid
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Restrict)
  text           String
  isQuickMessage Boolean  @default(false)
  quickMessageId String?
  createdAt      DateTime @default(now())

  @@index([journeyId, createdAt])
}

model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  journeyId String   @db.Uuid
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  raterId   String   @db.Uuid
  rater     User     @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Restrict)
  ratedId   String   @db.Uuid
  rated     User     @relation("RatingsReceived", fields: [ratedId], references: [id], onDelete: Restrict)
  stars     Int
  comment   String?
  // TEAM-ANSWERS G2 (item 15) — optional low-star reason key. Nullable
  // and additive: every existing row keeps meaning exactly what it
  // meant. Values are RatingReason (packages/shared/src/types/rating.ts).
  reason    String?
  createdAt DateTime @default(now())

  @@unique([journeyId, raterId])
}

// TEAM-ANSWERS G3 — the driver's half of item 15, as an incident report
// rather than a grade.
//
// The team asked for driver-rates-passenger "to identify and manage
// issues from both sides". The goal ships; the mechanism does not. This
// row carries a reason, optional details, and the journey it is about —
// no stars, no score, no per-customer aggregate. The admin sees who the
// customer was THROUGH the journey, exactly as with every other conflict
// type, and repeated reports about one rider are visible in the conflicts
// list the same way repeated anything else is.
//
// One report per journey per driver (@@unique), so a report is a single
// statement about a single ride and not a counter anyone can run up.
model RideReport {
  id         String   @id @default(uuid()) @db.Uuid
  journeyId  String   @db.Uuid
  journey    Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  reporterId String   @db.Uuid
  reporter   User     @relation("RideReportsFiled", fields: [reporterId], references: [id], onDelete: Restrict)
  reason     String
  details    String?
  createdAt  DateTime @default(now())

  @@unique([journeyId, reporterId])
  @@index([createdAt])
}

model SyncEvent {
  id              String   @id @default(uuid()) @db.Uuid
  journeyId       String?  @db.Uuid
  journey         Journey? @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType       String
  payload         Json
  clientTimestamp DateTime
  serverTimestamp DateTime @default(now())
  clientEventId   String   @unique

  @@index([journeyId, clientTimestamp])
  @@index([userId, serverTimestamp])
}

// R3-SYNC-REJECTION-MODEL — values mirror packages/shared/src/types/sync-rejection.ts
// (SyncRejectionCodes). Keep in lockstep: a divergence breaks the Prisma typecheck
// against rejection.code in sync.service.ts.
enum SyncRejectionCode {
  FK_VIOLATION
  DUPLICATE_EVENT_ID
  VALIDATION_ERROR
  STALE_TIMESTAMP
  PERMISSION_DENIED
  UNKNOWN
}

// R3-SYNC-REJECTION-MODEL — persisted server-side rejection of a sync-event upload
// attempt. Sibling to SyncEvent: a persisted SyncEvent is a successful sync; a
// persisted SyncRejection is a server-rejected sync. Together they form the
// denominator for the funnel-metrics offline-sync-success ratio (see
// services/funnel-metrics.service.ts).
//
// Out of scope: client-side failures that never reached the server (no network,
// JS exception, etc.). Those are tracked via Sentry + client-side error reporting.
model SyncRejection {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientEventId    String
  eventType        String
  rejectionCode    SyncRejectionCode
  rejectionMessage String
  payloadSummary   String?
  serverTimestamp  DateTime          @default(now())

  @@index([serverTimestamp])
  @@index([userId, serverTimestamp])
}

model OtpCode {
  id        String   @id @default(uuid()) @db.Uuid
  phoneHash String
  userId    String?  @db.Uuid
  purpose   String?
  // PREPROTO-AUTH G1 — stores hmacOtp(plaintext), never the SMS code
  // itself. Verification fetches by phoneHash/id and compares the HMAC
  // in constant time, so no query ever filters on `code`.
  code         String
  attemptCount Int      @default(0)
  expiresAt    DateTime
  used         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([phoneHash, purpose, used, expiresAt])
  @@index([userId, purpose, used])
}

// PREPROTO-AUTH G3 — server-side session store (adversarial review #3).
// One row per issued refresh token. `familyId` groups a rotation chain:
// login mints a family, every refresh rotates to a new jti in the same
// family (old row gets replacedByJti). Presenting an already-rotated or
// revoked token is theft-detection and revokes the entire family.
// hashedToken (sha256 of the signed JWT) binds the row to the exact
// token string, never the raw token at rest.
model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  jti           String    @unique
  userId        String    @db.Uuid
  familyId      String
  hashedToken   String
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedByJti String?
  createdAt     DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([familyId])
}

model AmlFlag {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  journeyId       String?         @db.Uuid
  journey         Journey?        @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  escrowId        String?         @db.Uuid
  escrow          Escrow?         @relation(fields: [escrowId], references: [id], onDelete: SetNull)
  type            AmlFlagType
  severity        AmlFlagSeverity
  status          AmlFlagStatus   @default(OPEN)
  detectedAt      DateTime        @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?         @db.Uuid
  resolutionNotes String?
  metadata        Json?

  @@index([userId, detectedAt])
  @@index([status, severity])
  @@index([type, detectedAt])
}

