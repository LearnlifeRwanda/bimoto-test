  conflictDecision            ConflictDecision?
  prevHash                    String            @default("")
  entryHash                   String
  crossLinkedEscrowAuditLogId String?           @db.Uuid
  createdAt                   DateTime          @default(now())

  admin User @relation("AdminActions", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([conflictType])
  @@index([createdAt])
