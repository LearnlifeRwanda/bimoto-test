enum MobilityTier {
  DENSE
  MEDIUM
  LOW
  SPARSE
}

enum MobilityAggregateType {
  POINT_DENSITY
  OD_MATRIX
}

// Dispatch M — first-class cooperative entity. The metadata: Json
// field is the extensibility hatch: per-cooperative business rules
// (commission overrides, membership criteria, reporting cadences)
// land here without another schema migration. onDelete: Restrict on
// FK references so a cooperative cannot be deleted while drivers /
// leader still reference it.
model Cooperative {
  id                 String   @id @default(cuid())
  name               String   @unique
  registrationNumber String?
  leaderId           String?  @unique @db.Uuid
  commissionRate     Float    @default(0.0)
  currency           String   @default("RWF")
  metadata           Json     @default("{}")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  leader  User?           @relation("CooperativeLed", fields: [leaderId], references: [id], onDelete: SetNull)
  drivers DriverProfile[] @relation("DriversInCooperative")
  members User[]          @relation("UsersInCooperative")
  // R3-DRIVER-SCREENER — drivers who self-declared affiliation in the screener.
  screenerAffiliations DriverScreener[] @relation("CooperativeScreenerAffiliation")

  @@index([leaderId])
  @@index([active])
  @@index([name])
}

model MobilityAggregate {
  id             String                @id @default(cuid())
  tier           MobilityTier
  aggregateType  MobilityAggregateType
  cellId         String
  cellCenterLat  Float
  cellCenterLng  Float
  bucketStart    DateTime
  bucketEnd      DateTime
  count          Int
  attributesJson Json?
  computedAt     DateTime              @default(now())

  @@unique([tier, aggregateType, cellId, bucketStart])
  @@index([tier, bucketStart])
  @@index([aggregateType])
  @@index([cellId])
  @@index([bucketStart])
}

model DeviceToken {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     PushPlatform
  token        String       @unique
  isActive     Boolean      @default(true)
  failureCount Int          @default(0)
  createdAt    DateTime     @default(now())
  lastSeenAt   DateTime     @default(now())

  @@index([userId, isActive])
}

// PREPROTO-SIM G3 — outbound SMS captured when SMS_MODE=simulated. This
// includes login OTP codes, so the rows are as sensitive as passwords:
// the ONLY read path is the guarded /api/sim routes (admin session or
// constant-time SIM_INBOX_TOKEN). No relation to User by design — the
// simulated transport, like the real one, only knows a phone number.
model SimulatedMessage {
  id        String   @id @default(uuid()) @db.Uuid
  toPhone   String
  body      String
  category  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// BLACKBOX G4 — an error-report bundle a user chose to send.
//
// The rows here are the client's error ledger as it stood when someone
// tapped Send report on the Diagnostics screen. Nothing arrives here
// automatically: the client has no background upload path, and this
// table only ever grows by an explicit human action.
//
// `entries` is the ledger verbatim — already redacted on the device
// (services/error-ledger.ts strips tokens, masks phone shapes and drops
// query strings BEFORE persisting), already capped there, and capped
// again on the way in by the route. It is stored as Json rather than
// parsed into columns on purpose: the team reads and forwards bundles,
// nothing queries inside them, and a schema that claimed to understand
// the shape would go stale the first time a new entry kind appeared.
model ErrorReport {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The reporter's role at the moment of sending — a driver's crash and
  /// a customer's crash are different stories.
  reporterRole UserRole
  /// The app build the phone was running (__APP_BUILD_SHA__).
  appBuild     String
  /// How many ledger entries the bundle carries, denormalised so the
  /// admin list does not have to open every bundle to count them.
  entryCount   Int
  entries      Json

  /// FLIGHT-RECORDER G4 — the stable identity of the fault this bundle is
  /// ABOUT, taken from its newest entry: what kind of failure, what it
  /// said with ids and numbers flattened, and the top stack frame
  /// (errorFingerprint in @bimoto/shared). Always computed here, never
  /// read from the request — the route does not trust client shape, and a
  /// deployed APK sends no fingerprint at all. NULL on every report
  /// stored before this column existed; the admin read-out groups those
  /// as "unfingerprinted" rather than guessing.
  fingerprint  String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([fingerprint])
}

// SOS-FOLLOW G2 — an emergency becomes a state.
//
// Before this model there was only an event: the press wrote a SyncEvent
// (the offline-capable ledger, which stays exactly as it is and remains
// what the client's sync path uploads into) and fanned five channels
// out. An event log can say "somebody pressed the button at 14:02". It
// cannot say "this journey is IN an emergency right now", which is the
// only question that matters to the two things this dispatch adds: may
// this device stream its position, and has anybody closed this yet.
//
// So the row is the STATE and the SyncEvent is the LOG. They coexist
// additively — no existing reader of either changes — and the invariant
// that makes the state usable is ONE ACTIVE ROW PER JOURNEY, enforced by
// a partial unique index in the migration (Prisma cannot express one;
// see FeeWaiver_one_nonrevoked_per_driver in the LAUNCH-TRUTH migration
// for the precedent this copies) and by a find-then-create in the press
// handler.
//
// An alert ALWAYS ends. RESOLVED is an admin closing it with a written
// note through the appendAdminActionTx hash chain; EXPIRED is the
// 60-minute valve in jobs/emergency-expiry.job.ts closing one nobody
// closed. There is no third resting state, and journey completion is
// deliberately NOT one of them: an emergency can outlive the ride it
// started on, and a ride that ends while somebody is still in trouble
// must not quietly stop the follow.
model EmergencyAlert {
  id        String  @id @default(uuid()) @db.Uuid
  journeyId String  @db.Uuid
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  /// WHO pressed the button — the caller, which on a driver-raised alert
  /// is not the journey's customer. Kept alongside raisedByRole because
  /// the role is what every surface branches on and resolving the id to
  /// a role later would need a join the ops list cannot afford.
  raisedById   String @db.Uuid
  raisedBy     User   @relation("EmergencyAlertsRaised", fields: [raisedById], references: [id], onDelete: Restrict)
  raisedByRole String

  /// Where the phone was AT THE PRESS, when it could say. Nullable
  /// throughout: a geolocation read that is slow, denied or unavailable
  /// must never delay or block the alert, so an alert with no press
  /// position is a normal alert, not a degraded one.
  pressLat Float?
  pressLng Float?

  status    EmergencyAlertStatus @default(ACTIVE)
  createdAt DateTime             @default(now())

  resolvedAt   DateTime?
  /// NULL when the valve expired it rather than a person closing it —
  /// which is exactly the distinction `status` records, so the ops
  /// history can say "closed by ops" or "timed out" without guessing.
  resolvedById String?   @db.Uuid
  resolvedBy   User?     @relation("EmergencyAlertsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolveNote  String?

  /// Serves the ops ACTIVE list and the retention hold's NOT EXISTS.
  @@index([status, createdAt])
  /// Serves the press handler's "is there already an ACTIVE row" lookup
  /// and the history tab's per-journey read.
  @@index([journeyId, createdAt])
}

// SOS-FOLLOW G2 — the three states an emergency can be in, and there is
// no fourth. ACTIVE is the only one that permits a follow stream; both
// terminal states stop it, release the retention hold, and are announced
// to the admins room and to the journey room alike.
enum EmergencyAlertStatus {
  ACTIVE
  RESOLVED
  EXPIRED
}

// ACCOUNT-RIGHTS-CORE G1 — a deletion becomes a request with a clock on
// it, not a button that erases.
//
// The 72-hour hold (D1, 20 Aug) is the whole point: everything in the app
// keeps working during the window, the request is cancellable, and only
// when the clock runs out — and no blocking state is in the way — does the
// erasure run. Law 058/2021 measures its 30-day compliance clock from
// `requestedAt`, which is why the request timestamp and the execution
// timestamp are two separate columns rather than one.
//
// ONE PENDING REQUEST PER USER, enforced by a PARTIAL unique index that
// PSL cannot express (@@unique has no WHERE clause). It lives in raw SQL
// in migration 20260824000000_account_rights_core_deletion_request:
//   CREATE UNIQUE INDEX "DeletionRequest_one_pending_per_user"
//     ON "DeletionRequest"("userId") WHERE "status" = 'PENDING'
// — the same shape PAYOUT-IDEMPOTENCY used for the in-flight payout batch
// (20260729000000) and SOS-FOLLOW for the active emergency alert
// (20260819000000). Prisma's introspection ignores partial indexes, so
// the migration-faithfulness gate never proposes dropping it. Do NOT add
// a plain @@unique([userId]) here: that would forbid a user from ever
// requesting deletion twice, when the whole cancel path exists so they
// can change their mind and come back.
//
// The service still does a find-then-create as well. The index is what
// makes the invariant true under a double-tap; the service check is what
// makes the refusal a clean 409 instead of a database error.
model DeletionRequest {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  // Cascade, and it never fires: erasure ANONYMISES the User row, it
  // never deletes it (29 relation fields at 297cb1d depend on that row
  // existing). The cascade is here so the schema states the ownership
  // truthfully, not because any code path hard-deletes a user.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status      DeletionRequestStatus @default(PENDING)
  requestedAt DateTime              @default(now())
  executesAt  DateTime
  cancelledAt DateTime?
  executedAt  DateTime?

  /// Machine-readable reason the execution job skipped this row on its
  /// last attempt (e.g. `NON_TERMINAL_JOURNEY`, `LIVE_ESCROW`). Null when
  /// nothing is in the way. A deferral never cancels and never
  /// force-executes: the row keeps retrying and this column is what the
  /// admin surface reads to say why.
  deferredReason String?

  /// Serves the execution job's due-row sweep.
  @@index([status, executesAt])
  /// Serves the per-user "do I have a pending request" read on GET /me.
  @@index([userId, status])
}

// ACCOUNT-RIGHTS-CORE G1 — the three states a deletion request can be in.
// PENDING is cancellable; both terminal states are not. A user who
// cancels and asks again gets a NEW row, so the history of asking is
// preserved rather than overwritten.
enum DeletionRequestStatus {
  PENDING
  CANCELLED
  EXECUTED
}

// ACCOUNT-RIGHTS-CORE G1 — what Bimoto is allowed to remember about a
// deleted account, and nothing else.
//
// Founder ruling D2 (20 Aug), verbatim scope: after erasure Bimoto keeps
// ONLY the phone hash, the deletion count, and a was-suspended flag. That
// is three facts, and this table has exactly three columns beyond the key
// they are keyed by. A test pins `Object.keys` against that list in both
// directions, because the pressure on a table like this is always to grow
// one more "harmless" column.
//
// Why it must exist at all: the erasure replaces the User row's phoneHash
// with a hash of `DELETED-<id>`, which is the correct thing to do — the
// account must stop being findable by phone number. But it also destroys
// the only key by which a returner can be recognised, and without that a
// suspended user could delete their account and re-register clean. That
// is reactivation-by-deletion, which the founder ruled out. So the
// ORIGINAL hash is copied here in the same transaction that destroys it
// on the User row.
//
// Deliberately NOT here: any relation to User (the tombstone must outlive
// and out-scope the row), the encrypted phone (a hash is one-way; a
// ciphertext is not), the nickname, the user id, and the deletion
// timestamps of every individual deletion. `lastDeletedAt` is the most
// recent one; earlier ones are counted, not dated.
//
// The key is a HASH, never a number: the phone-access convention guard
// (src/__tests__/phone-access-convention.test.ts) applies here as
// everywhere else.
model AccountTombstone {
  /// The ORIGINAL phoneHash — the value the User row carried before
  /// erasure overwrote it. hashPhone() output, never a dialable number.
  phoneHash String @id

  /// How many times an account on this number has been deleted. Read by
  /// registration; never shown to the returner.
  deletionCount Int @default(0)

  /// True if the account was suspended or frozen at the moment of
  /// erasure. Sticky: once true it stays true across later deletions, so
  /// a suspended user cannot launder the flag with a second clean cycle.
  wasSuspended Boolean @default(false)

  /// When the most recent erasure on this number committed.
  lastDeletedAt DateTime
}
