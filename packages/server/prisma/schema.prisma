enum AdminActionType {
  FREEZE_USER
  UNFREEZE_USER
  HOLD_PAYOUT
  RELEASE_PAYOUT
  RESOLVE_JOURNEY_RECONCILIATION
  RESOLVE_AML_APPEAL
  RESOLVE_BID_MANIPULATION
  RESOLVE_GPS_PLAUSIBILITY
  RESOLVE_STALE_DRIVER_NO_SHOW
  RESOLVE_PHOTO_MISMATCH
  RESOLVE_GRAPH_ANOMALY
  RESOLVE_DRIVER_NO_SHOW_DISPUTE
  RESOLVE_RECIPIENT_DISPUTE
  RESOLVE_RIDE_REPORT
  COOPERATIVE_LEADER_ACTION
  COOPERATIVE_DISPATCH
  REVOKE_DRIVER
  GRANT_FEE_WAIVER
  EXTEND_FEE_WAIVER
  REVOKE_FEE_WAIVER
  // SOS-FOLLOW G3 — an admin closes a live emergency. Same RESOLVE_*
  // convention as every conflict decision above, and written through
  // the same appendAdminActionTx hash chain: an emergency that ends
  // leaves an entry naming who ended it and why.
  RESOLVE_EMERGENCY_ALERT
}

// LAUNCH-TRUTH G1 — the two pilot fee-waiver instruments.
// LIFETIME: 12 grants total for the pre-prototype test drivers, never
// expires. TEMPORARY: capped grants (500, env-tunable upward), 6 months,
// extendable to 12 months total per driver. Both cover rides and parcels
// alike — one rule, so "you keep 100% of what you earn" stays literal.
enum FeeWaiverType {
  LIFETIME
  TEMPORARY
}

enum FreezeCategory {
  AML_CRITICAL
  FRAUD_SUSPECTED
  SAFETY_CONCERN
  KYC_PENDING
  REGULATORY_REQUEST
  ADMIN_DISCRETION
}

enum ConflictType {
  JOURNEY_RECONCILIATION
  AML_APPEAL
