DATABASE_URL="postgresql://bimoto:bimoto_dev@localhost:5432/bimoto"
# Optional Prisma pool tuning (DB-RESILIENCE). Defaults are sized for
# the single-machine pilot; you normally do not need to set these.
# Applied as connection_limit / pool_timeout / connect_timeout URL
# parameters unless DATABASE_URL already carries them (the URL wins).
# DB_POOL_SIZE=30
# DB_POOL_TIMEOUT_SECONDS=10
# DB_CONNECT_TIMEOUT_SECONDS=5
# Secrets must be >= 32 chars; the server refuses to start on these
# placeholder values (generate real ones: `openssl rand -hex 32`).
JWT_SECRET="change-this-to-a-random-64-char-string"
JWT_REFRESH_SECRET="change-this-to-a-different-random-64-char-string"
ENCRYPTION_KEY="change-this-to-a-32-byte-hex-string"
# Optional dedicated key for the OTP-at-rest HMAC (>= 32 chars).
# Falls back to ENCRYPTION_KEY when unset. A set-but-weak value is a
# hard startup error, so it stays commented out until you set a real one.
# OTP_HMAC_KEY=""
# Wrong guesses allowed per OTP code before it is invalidated (default 5).
OTP_MAX_ATTEMPTS=5
# Session cookies carry the Secure flag when true (default). Only set to
# false for plain-HTTP local development.
COOKIE_SECURE=true
PORT=3000
CLIENT_URL="http://localhost:5173"
# Comma-separated CORS allow-list. Empty = allow only CLIENT_URL.
# Add the Capacitor WebView origin (https://localhost) for the native app.
CORS_ORIGINS=""
# Express trust-proxy: 'false' (default) = no proxy in front; 'true' =
# exactly one trusted hop (e.g. Cloudflare Tunnel); or a number/preset.
TRUST_PROXY="false"
NODE_ENV="development"

# ---------------------------------------------------------------------------
# PREPROTO-SIM pilot switches — the control surface, previously invisible
# ---------------------------------------------------------------------------
# These decide whether the server moves real money and sends real SMS. They
# were read by config.ts and documented nowhere, which meant the only way to
# know a pilot's actual mode was to read the source. startup-guard.ts refuses
# to boot on any combination that could be confused for the other.

# 'live' talks to Flutterwave; 'simulated' swaps in the in-process fake.
PAYMENTS_MODE="live"

# 'live' sends through Africa's Talking; 'simulated' captures every message
# in the /api/sim inbox instead. A PRODUCTION server on 'live' with no
# AT_API_KEY refuses to start rather than silently sending nothing.
SMS_MODE="live"

# Which SMS commands a registered user may actually run. SMS authenticates
# by CALLER ID — weaker than the app's session — so 'safe' (the default, and
# the pilot's mode) leaves rights and reads on: STOP, HELP, STATUS, BALANCE,
# and the parcel-recipient receipt replies. Every money or marketplace
# command (confirm, dispute, cancel, accept/decline bid) answers "use the
# app" instead. 'full' is the whole set and exists to exercise the gated
# paths; startup-guard.ts REFUSES TO BOOT 'full' against PAYMENTS_MODE=live,
# so the flag alone can never point SMS money actions at real francs.
SMS_COMMAND_TIER="safe"

# The support number the HELP reply offers, in E.164 (e.g. "+250788123456").
# UNSET MEANS THE SUPPORT CLAUSE IS OMITTED — a real number or silence. The
# template used to carry "+250 XXX XXX XXX", which nobody caught because
# HELP had never run for a registered user until the sender lookup was
# fixed. If you would rather route support to the ops line, set this to the
# same number as EMERGENCY_OPS_PHONE below; nothing is inferred.
SUPPORT_PHONE=""

# COUNTER-READY — the one-counter-per-bid experiment. THIS IS THE SWITCH
# UPDATE 7 FLIPS. The whole counter-offer machinery ships in APK 14 asleep
# (ruling D4, 24 Aug + the dormant-shipping decision, 25 Aug): the
# experiment starts only after several weeks of plain bidding have
# produced a baseline, because a marketplace measured only after a
# mechanic was added to it cannot say what the mechanic did.
#
# Set to "true" on the pilot server and restart. No new APK, no store
# round, no rebuild — which is why it lives HERE and not in a VITE_*
# variable, which would be baked into the bundle at build time. The app
# learns the value from /api/health at boot.
#
# Until then both counter endpoints answer 403 COUNTER_DISABLED and the
# app renders nothing at all. Default false, and false is the safe
# direction: an unreachable health endpoint never enables a dormant
# feature.
COUNTER_BID_ENABLED="false"

# Deliberate override for running a simulated pilot on a production-mode
# server (e.g. behind the Cloudflare Tunnel doorway). Without it, any
# simulated mode under NODE_ENV=production is a hard startup refusal.
ALLOW_SIMULATED_IN_PROD="false"

# Bearer token for the simulated-SMS inbox. That inbox delivers login OTPs,
# so a set-but-weak token is a hard startup error. Empty = token access
# disabled (admin sessions still work); >= 32 chars otherwise.
SIM_INBOX_TOKEN=""

# Skips driver document verification. Pilot convenience only — a driver
# reaches the road without anyone checking a licence.
SKIP_DRIVER_VERIFICATION="false"
# ---------------------------------------------------------------------------

# Africa's Talking SMS Gateway
AT_API_KEY="your-africas-talking-api-key"
AT_USERNAME="sandbox"

# Flutterwave Payment Gateway
FLW_SECRET_HASH="your-flutterwave-webhook-secret-hash"
FLW_PUBLIC_KEY=""
FLW_SECRET_KEY=""
FLW_ENCRYPTION_KEY=""
FLW_ENV="sandbox"

# PAY-TRUTH G4 — what the SIMULATED gateway does when asked to charge.
# Only meaningful with PAYMENTS_MODE=simulated; the server REFUSES to
# start if it is set against a live gateway. 'none' (default) is the
# always-succeeds behaviour the pilot has always had. The others make the
# in-process fake fail the way a real gateway does, through the same
# error mapping, so the whole money path above the SDK runs unchanged and
# every row of docs/payment-failure-matrix.md becomes reachable in the
# field instead of only in a harness.
# One of: none | insufficient_funds | invalid_wallet | declined | timeout | gateway_down
SIMULATED_FAILURE_MODE="none"

# ---------------------------------------------------------------------------
# Test-only switches
#
# Everything in this section exists for CI and local harnesses. None of it
# belongs on a pilot server, and the server refuses to start where the
# combination could be mistaken for real money.
# ---------------------------------------------------------------------------

# PILOT-GUARD Item 4 — the E2E payments hatch.
#
# '1' makes chargeCard return a synthetic SUCCESS without calling the
# gateway, and lets the bid and payment-retry rails move an escrow
# PENDING→HELD against a synthetic 'e2e-' transaction id, so the
# dispute / refund / release flows are exercisable in CI with no gateway
# keys. It is set in .github/workflows/e2e.yml and belongs nowhere else.
#
# The server REFUSES to start with '1' against PAYMENTS_MODE=live: that
# combination reports fares held that were never charged, and the escrow
# row says HELD, so nothing downstream disagrees. Use
# PAYMENTS_MODE=simulated if you need the hatch outside CI.
# One of: 0 | 1
E2E_FAKE_PAYMENTS="0"

# LocationIQ geocoding (address autocomplete + reverse geocoding + road
# directions for the route preview). Server-side only — never expose to
# the client; all lookups go through /api/geocode. When empty, address
# search and /api/geocode/directions answer 503 and the app falls back
# to map + GPS (and a straight-line route preview).
LOCATIONIQ_API_KEY=""

# Offline Kigali map (MAP-CACHE / MAP-TRUTH G3). OPTIONAL OVERRIDE — you
# almost certainly do not need to set this.
#
# The extract served at GET /api/map/kigali.pmtiles is found by default
# at data/kigali.pmtiles, with no configuration: build it with
#   sh scripts/build-kigali-pmtiles.command
# and scripts/update-pilot.command carries it across updates. That
# default rung exists because the updater promises your settings are kept
# exactly as they are, so it must never write this variable — and when
# this variable was the ONLY way to point at the file, it was empty
# everywhere and the whole offline map stayed dark.
#
# Set it only to serve an archive from somewhere other than the default
# location; an absolute path is expected. A path that is set but missing
# is a clean 404 rather than a silent fall back to the default, because
# an operator who names a file means that file. When neither this nor the
# default resolves, the endpoint answers 404 MAP_NOT_AVAILABLE and the app
# keeps using online tiles.
MAP_PMTILES_PATH=""

# Sentry Error Monitoring (optional)
SENTRY_DSN=""

# Designated ops phone for rider-emergency SMS (SOS fan-out). When a
# rider triggers SOS mid-ride this number gets an SMS with the journey
# id and rider phone. Empty = ops-SMS channel skipped (a warning is
# logged); the admin socket alert and emergency-contact SMS still fire.
EMERGENCY_OPS_PHONE=""

# BNR monthly compliance report — output directory for the generated
# PDF/CSV pairs (one sub-directory per YYYY-MM period). Leave empty to
# use the default, ~/.bimoto/reports/bnr, which a normal user account
# can write to on macOS, Linux and the Render container; the directory
# is created on first run. Set this to relocate the reports (the Kigali
# pilot server points it at its own managed volume). The other BNR
# knobs — BNR_RETENTION_YEARS, BNR_TIMEZONE, BNR_CRON_SCHEDULE,
# BNR_GENERATION_TIMEOUT_MS, BNR_PDF_PAGE_SIZE — keep their defaults.
BNR_REPORT_DIR=""

# ---------------------------------------------------------------------------
# Operational keys that render.yaml sets and this file did not mention
# ---------------------------------------------------------------------------
# The two files disagreed in both directions. These are the ones a local or
# self-hosted operator can act on; the Render-only push credentials (APNS_*,
# FCM_SERVICE_ACCOUNT_JSON) stay out because they are deploy-surface, not
# app configuration.

# Inbound SMS webhook (Africa's Talking). AT_INBOUND_HMAC_SECRET
# authenticates the callback; AT_INBOUND_SHORTCODE is the number replies
# arrive on. Empty = the inbound leg (reply "1" to confirm, "2" to dispute)
# is not usable.
AT_INBOUND_HMAC_SECRET=""
AT_INBOUND_SHORTCODE=""

# BNR report timezone. Defaults to Africa/Kigali; set only to override.
# BNR_TIMEZONE="Africa/Kigali"

# Cron schedules for the two background analyses. Both have in-code
# defaults; set only to move them.
# GRAPH_DETECTION_CRON="0 3 * * *"
# MOBILITY_AGGREGATION_CRON="0 2 * * *"

# Client (Vite) — set during build, baked into bundled JS
# Read by import.meta.env.VITE_API_URL across packages/client/src/**.
# In CI, the Android Build workflow sets this to the production Render URL.
VITE_API_URL="https://bimoto-api.onrender.com"
